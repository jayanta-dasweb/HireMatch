# Local development — copy to .env and adjust. Never commit real secrets.

APP_ENV=development
DEBUG=true
SECRET_KEY=hirematch-dev-secret-key-change-in-prod-32

# Backend
DATABASE_URL=postgresql+psycopg2://hirematch:hirematch@db:5432/hirematch
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=2
RATE_LIMIT_ENABLED=true
WEB_CONCURRENCY=1

# Email: console logs tokens; Mailhog captures SMTP if EMAIL_BACKEND=smtp
EMAIL_BACKEND=console
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hirematch.local

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Postgres (compose)
POSTGRES_USER=hirematch
POSTGRES_PASSWORD=hirematch
POSTGRES_DB=hirematch
