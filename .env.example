# Local development — copy to .env and adjust. Never commit real secrets.

APP_ENV=development
DEBUG=true
SECRET_KEY=hirematch-dev-secret-key-change-in-prod-32

# Backend
DATABASE_URL=postgresql+psycopg2://hirematch:hirematch@db:5432/hirematch
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=2
RATE_LIMIT_ENABLED=true
WEB_CONCURRENCY=1
SEED_PLATFORM_ADMIN=true
SEED_DEMO_USER=false

# Email: console logs tokens; Mailhog captures SMTP if EMAIL_BACKEND=smtp
EMAIL_BACKEND=console
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hirematch.local

# Resumes (Phase 2)
RESUME_STORAGE_PATH=/data/resumes
RESUME_MAX_BYTES=10485760
# noop | reject_all (tests). Real ClamAV later.
RESUME_MALWARE_SCANNER=noop
# Embedded open model (downloads once into HF_HOME; no cloud inference API)
RESUME_LLM_ENABLED=true
RESUME_LLM_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
HF_HOME=/data/hf_cache

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Postgres (compose)
POSTGRES_USER=hirematch
POSTGRES_PASSWORD=hirematch
POSTGRES_DB=hirematch
