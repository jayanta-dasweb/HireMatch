# Production secrets template — copy to .env.production and fill real values.
# NEVER commit .env.production

APP_ENV=production
DEBUG=false
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_48_OR_LONGER________________

POSTGRES_USER=hirematch
POSTGRES_PASSWORD=REPLACE_STRONG_DB_PASSWORD
POSTGRES_DB=hirematch
REDIS_PASSWORD=REPLACE_STRONG_REDIS_PASSWORD

DATABASE_URL=postgresql+psycopg2://hirematch:REPLACE_STRONG_DB_PASSWORD@db:5432/hirematch
REDIS_URL=redis://:REPLACE_STRONG_REDIS_PASSWORD@redis:6379/0

# Public URLs your users hit (behind nginx)
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com
TRUSTED_HOSTS=your-domain.com,www.your-domain.com,api,localhost
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=2

RATE_LIMIT_ENABLED=true
WEB_CONCURRENCY=2

# Private resume files (Docker volume resume_data_prod)
RESUME_STORAGE_PATH=/data/resumes
RESUME_MAX_BYTES=10485760
RESUME_MALWARE_SCANNER=noop

# Real SMTP required for production email delivery
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com

HTTP_PORT=80
HTTPS_PORT=443
